# ============================================
# wxtools 环境变量模板
# 使用方法：cp .env.example .env 然后按需修改
# ============================================

# ---- 抖音解析（可选）----
# 抖音反爬需要登录 cookie 才能获取无水印视频地址。
# 不配置则抖音解析不可用（返回 503 提示），其余平台（B站/快手/小红书/PDF）不受影响。
#
# 获取方式：浏览器登录 douyin.com → F12 开发者工具 → Application/Storage/Cookies
# → 复制所有 douyin.com 的 cookie（或至少 sessionid + ttwid）
DOUYIN_COOKIE=

# ---- 后端端口映射（可选，默认 3005）----
# 访问地址：http://localhost:3005
# 如需改端口：改 docker-compose.yml 中 server.ports 的左侧即可
# SERVER_PORT=3005

# ---- 解析服务端口（可选，默认 3008）----
# RESOLVER_PORT=3008
